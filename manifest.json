{
  "id": "adanos-sentiment",
  "name": "Adanos Sentiment",
  "version": "1.1.0",
  "description": "Overlay Adanos stock sentiment from Reddit, X, news, and Polymarket on your largest portfolio holdings",
  "author": "Adanos",
  "main": "dist/addon.js",
  "sdkVersion": "3.7.0",
  "minWealthfolioVersion": "3.7.0",
  "enabled": true,
  "contributes": {
    "routes": [
      { "id": "adanos-sentiment" },
      { "id": "adanos-sentiment-settings", "path": "settings" }
    ],
    "links": {
      "sidebar": [
        {
          "id": "adanos-sentiment",
          "route": "adanos-sentiment",
          "label": "Adanos Sentiment",
          "icon": "chart-line-up",
          "order": 180
        }
      ]
    }
  },
  "hostDependencies": {
    "@tanstack/react-query": "^5.90.0",
    "@wealthfolio/addon-sdk": "^3.7.0",
    "@wealthfolio/ui": "^3.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "network": {
    "allowedHosts": ["api.adanos.org"]
  },
  "permissions": [
    {
      "category": "portfolio",
      "functions": ["getHoldings"],
      "purpose": "Read the current portfolio holdings and map the largest positions to Adanos ticker sentiment"
    },
    {
      "category": "secrets",
      "functions": ["set", "get", "delete"],
      "purpose": "Store the Adanos API key securely in addon-scoped encrypted storage"
    },
    {
      "category": "network",
      "functions": ["request"],
      "purpose": "Fetch sentiment and quota data from api.adanos.org for portfolio tickers"
    }
  ]
}
